{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--filter", "web", "dev:preview"],
      "port": 3334,
      "autoPort": true
    },
    {
      "name": "web-static",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["serve", "packages/web/out", "-l", "3336"],
      "port": 3336
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["serve", "packages/docs/out", "-l", "3335"],
      "port": 3335
    },
    {
      "name": "playground",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--filter", "playground", "start", "--port", "3001"],
      "port": 3001
    }
  ]
}
