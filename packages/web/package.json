{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/emit-sample-sources.mjs && next dev --port 3334",
    "dev:preview": "NEXT_DIST_DIR=.next-preview next build && OUT_DIR=.next-preview node scripts/serve-out.mjs",
    "build": "node scripts/emit-sample-sources.mjs && next build",
    "start": "serve out",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.8.3",
    "fumadocs-docgen": "^3.0.10",
    "fumadocs-mdx": "14.3.1",
    "fumadocs-ui": "16.8.3",
    "grid": "1.0.0",
    "lucide-react": "^1.9.0",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "samples": "0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
