{
  "name": "superplot-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun --filter playground start",
    "playground:start": "bun --filter playground start",
    "grid:build": "bun --filter @superplot/grid build && bun --filter @superplot/react build",
    "web:start": "bun --filter web dev",
    "web:build": "rm -rf packages/web/out && bun --filter web build",
    "lint": "bun --filter '*' lint",
    "clean": "bun --filter '*' clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "bun@1.3.8"
}
